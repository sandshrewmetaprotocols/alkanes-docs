{
  "name": "alkanes.build",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "sdkBranch": "develop",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "dev:full": "pnpm setup:local && pnpm dev",
    "build": "pnpm build:docs && next build --webpack",
    "build:docs": "node scripts/build-docs.js",
    "build:all": "pnpm build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:live": "RUN_INTEGRATION=true vitest run tests/integration/live-rpc.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && pnpm db:seed",
    "db:studio": "prisma studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "setup": "pnpm docker:up && pnpm db:push",
    "setup:local": "pnpm docker:up && sleep 3 && pnpm db:push && pnpm db:seed",
    "gcp:setup": "bash ./gcp/setup.sh",
    "gcp:deploy": "bash ./gcp/deploy.sh",
    "gcp:setup-wif": "bash ./gcp/setup-github-wif.sh",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@alkanes/ts-sdk": "file:./ts-sdk",
    "bip322-js": "^2.0.0",
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@mdx-js/loader": "^3.0.0",
    "@mdx-js/react": "^3.0.0",
    "@next/mdx": "^16.0.8",
    "@noble/hashes": "^2.0.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tanstack/react-query": "^5.83.0",
    "bignumber.js": "^9.3.1",
    "bitcoin-address-validation": "^3.0.0",
    "bitcoinjs-lib": "^7.0.0",
    "bitcoinjs-message": "^2.2.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "ecpair": "^3.0.0",
    "gray-matter": "^4.0.3",
    "lightweight-charts": "^5.0.9",
    "lucide-react": "^0.560.0",
    "marked": "^14.0.0",
    "next": "^16.0.8",
    "next-intl": "^4.5.8",
    "process": "^0.11.10",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "redis": "^5.10.0",
    "rehype-highlight": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "tiny-secp256k1": "^2.2.4",
    "varuint-bitcoin": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@types/webpack": "^5.28.5",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.15",
    "autoprefixer": "^10.4.20",
    "bip39": "^3.1.0",
    "eslint": "^8",
    "eslint-config-next": "^15.0.5",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.3.0",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.0.15",
    "webpack": "^5.103.0"
  }
}
